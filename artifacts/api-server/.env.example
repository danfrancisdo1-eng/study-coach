# API server settings. Copy to .env (never commit it) or set in the host's secret store.
# Values here are placeholders only.

# Required
PORT=8080
NODE_ENV=development
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# AI provider. On Render these point at the OpenAI API directly (the names date from Replit);
# Claude is chosen with ANTHROPIC_API_KEY + AI_PROVIDER=anthropic (see render.yaml).
AI_INTEGRATIONS_OPENAI_BASE_URL=https://REPLACE_ME
AI_INTEGRATIONS_OPENAI_API_KEY=REPLACE_ME

# Optional
LOG_LEVEL=info
# Old: set automatically on Replit (not used since the move to Render); enables CORS for the Expo web preview in development only.
# REPLIT_DEV_DOMAIN=

# Optional per-feature model overrides (defaults live in src/ai/tasks.ts)
# AI_MODEL_TUTOR=
# AI_MODEL_SESSION_QUIZ=
# AI_MODEL_CLASSIC_QUIZ=
# AI_MODEL_SYLLABUS=
# AI_MODEL_EXAM_PLAN=
# AI_MODEL_IMAGE_OCR=

# Claude (Anthropic). Off unless AI_PROVIDER or AI_PROVIDER_<TASK> is "anthropic".
# AI_PROVIDER=openai
# AI_PROVIDER_TUTOR=anthropic
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
