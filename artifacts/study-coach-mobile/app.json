{
  "expo": {
    "name": "Study Coach for iPhone",
    "slug": "study-coach-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "study-coach-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", {
        "photosPermission": "Allow Study Coach to select a photo or screenshot so you can review its extracted text before saving it to your course.",
        "cameraPermission": false,
        "microphonePermission": false
      }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
