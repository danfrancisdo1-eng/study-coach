{
  "expo": {
    "name": "RapidRecall AI",
    "slug": "study-coach-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "study-coach-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.danfrancis.studycoach",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "deploymentTarget": "17.0"
    },
    "android": {
      "package": "com.danfrancis.studycoach",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RapidRecall AI to select a photo or screenshot so you can review its extracted text before saving it to your course.",
          "cameraPermission": false,
          "microphonePermission": "Allow RapidRecall AI to use the microphone so you can record lectures for your own studying. Recordings stay on this iPhone unless you choose to transcribe them."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow RapidRecall AI to use the microphone so you can record lectures for your own studying. Recordings stay on this iPhone unless you choose to transcribe them.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "bb322c0a-8bad-4eee-ba73-67efc3f3df5a"
      }
    },
    "owner": "danfrancis"
  }
}
