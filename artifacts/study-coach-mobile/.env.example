# iPhone app settings. Copy to .env.local (never commit it).
# Only EXPO_PUBLIC_* values reach the app bundle, and they must be publishable, never secret.

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# API host without https://, e.g. api.example.com
EXPO_PUBLIC_DOMAIN=REPLACE_ME
# Optional: Clerk proxy URL when the backend proxies Clerk
# EXPO_PUBLIC_CLERK_PROXY_URL=
